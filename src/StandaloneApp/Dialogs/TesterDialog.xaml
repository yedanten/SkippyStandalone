<Window x:Class="Skippy.App.Dialogs.TesterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Special Thanks"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{StaticResource WindowBg}"
            BorderBrush="#FF5A4A1A"
            BorderThickness="1"
            CornerRadius="6"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <Grid Height="38" Background="{StaticResource TitleBarBg}" MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock Text="Special Thanks" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13"
                           Foreground="{StaticResource WarningBrush}" />
                <Button Content="&#xE8BB;" Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right"
                        Margin="0,0,6,0" Click="OnCloseClick" />
            </Grid>

            <StackPanel Margin="20,16,20,18">
                <TextBlock x:Name="TitleText" FontSize="15" Foreground="{StaticResource WarningBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" />

                <TextBlock x:Name="BodyText" Style="{StaticResource BodyText}" Margin="0,14,0,0" TextAlignment="Center" />

                <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}" Margin="0,14,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" FontStyle="Italic" />

                <Button Content="Close" Style="{StaticResource PrimaryButton}" Width="150"
                        HorizontalAlignment="Center" Margin="0,18,0,0" Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
