<Window x:Class="Skippy.App.Dialogs.RiskyWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warning"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{StaticResource WindowBg}"
            BorderBrush="#FF7A2A1A"
            BorderThickness="1"
            CornerRadius="6"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <Grid Height="38" Background="{StaticResource TitleBarBg}" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Warning" FontSize="13" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="&#xE8BB;" Style="{StaticResource TitleBarButton}" HorizontalAlignment="Right"
                        Margin="0,0,6,0" Click="OnCancelClick" />
            </Grid>

            <StackPanel Margin="18,14,18,18">
                <TextBlock Style="{StaticResource BodyText}"
                           Foreground="#FFF0C0B8"
                           Text="The skips contained within this category are very experimental and may carry a heavy ban risk.&#10;&#10;By enabling any of these, you accept full responsibility for any consequences. The developer has no responsibility for your choice of usage." />

                <CheckBox x:Name="DontShowAgainCheck"
                          Style="{StaticResource FeatureCheckBox}"
                          Content="Don't show this again!"
                          Margin="0,16,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Width="110" Click="OnCancelClick" />
                    <Button Content="I Agree &amp; Understand" Style="{StaticResource PrimaryButton}" Width="190"
                            Margin="12,0,0,0" Click="OnAgreeClick" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
