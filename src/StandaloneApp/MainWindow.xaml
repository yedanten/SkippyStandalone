<Window x:Class="Skippy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Skippy"
        Width="920"
        Height="700"
        MinWidth="780"
        MinHeight="560"
        Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#FF2A2A4D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ══ 标题栏 ═════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBg}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Skippy" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="  |  v2.2.5.0" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="KofiButton" Style="{StaticResource TitleBarButton}" Content="&#xEB51;" ToolTip="Support Skippy on Ko-fi" Click="OnKofiClick" />
                    <Button x:Name="DevButton" Style="{StaticResource TitleBarButton}" Content="&#xE713;" ToolTip="Developer Mode" Click="OnDevModeClick" />
                    <Button x:Name="BadgeToggleButton" Style="{StaticResource TitleBarButton}" Content="&#xE734;" ToolTip="Hide Badge" Click="OnBadgeToggleClick" />
                    <Rectangle Width="1" Height="16" Fill="#FF2A2A4D" Margin="6,0" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimizeClick" />
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- ══ 主体 ═══════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <DockPanel Grid.Column="0" Margin="10,10,4,8">
                    <Grid DockPanel.Dock="Top" Height="140" Margin="0,0,0,6">
                        <Border x:Name="PowerBorder"
                                Width="116" Height="116"
                                CornerRadius="14"
                                BorderThickness="2"
                                BorderBrush="{StaticResource AccentDimBrush}"
                                Background="#FF0E0E1C"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnPowerClick">
                            <Grid>
                                <Image x:Name="PowerImage" Source="/Assets/icon.png" Stretch="UniformToFill" />
                                <Border x:Name="PowerDim" Background="#CC000000" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavPanel" />
                    </ScrollViewer>
                </DockPanel>

                <!-- 右侧内容 -->
                <Border Grid.Column="1"
                        Margin="4,10,10,8"
                        Background="{StaticResource ContentBg}"
                        BorderBrush="#FF26264D"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <ContentControl x:Name="PageHost" />

                        <Button x:Name="BadgeOverlayButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,18,10"
                                Width="36"
                                Height="36"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnBadgeOverlayClick">
                            <Image x:Name="BadgeImage" Source="/Assets/badge_grey.png" Stretch="Uniform" />
                        </Button>

                        <!-- Toast -->
                        <Border x:Name="ToastPanel"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,22"
                                Padding="14,8"
                                CornerRadius="4"
                                Background="#FF1C1C3A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="ToastText" FontSize="12" TextWrapping="Wrap" MaxWidth="520" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ 底栏 ═══════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="10,0,10,0">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="11.5"
                           Foreground="#FF5A5A80"
                           Text="© Boxu - 2026 | Standalone v2.2.5.0" />
            </Grid>
        </Grid>
    </Border>
</Window>


